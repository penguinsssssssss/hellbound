# Bot User OAuth Token (OAuth & Permissions page, after "Install to Workspace")
SLACK_BOT_TOKEN=xoxb-...
# Channel ID (right-click the channel -> View channel details -> bottom) or #name
SLACK_CHANNEL=C0123456789

# Optional: this bot's own messages, one per line (see messages.example.txt)
# MESSAGES_FILE=messages.NAME.txt
